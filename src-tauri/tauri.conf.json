{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QBotWire",
  "version": "1.0.1",
  "identifier": "dev.moonlark.qbotwire",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QBotWire",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "QQ Bot API 调试台",
    "longDescription": "QBotWire 是一个用于调试腾讯 QQ Bot API v2 的桌面工具：实时接收网关事件、构造并发送 API 请求、缓存群聊与用户资料。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
